<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title | safe or site.name | safe }}</title>
  <meta name="description" content="{{ description | safe or site.defaultDescription | safe }}">
  {% set rawPath = canonical or page.url %}{% set cleanPath = rawPath | replace('index.html', '') | replace('.html', '') %}{% if cleanPath != '/' and cleanPath.endsWith('/') %}{% set cleanPath = cleanPath.slice(0, -1) %}{% endif %}{% set canonicalUrl = "https://sphaneufassociates.com" ~ cleanPath %}<link rel="canonical" href="{{ canonicalUrl }}">
  {% if robots %}
    <meta name="robots" content="{{ robots }}">
  {% else %}
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}
  
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="S. Phaneuf & Associates">
  <meta property="og:title" content="{{ title | safe or site.name | safe}}">
  <meta property="og:description" content="{{ description | safe or site.defaultDescription | safe }}">
  {# <meta property="og:description" content="Ready to start your residential or commercial project? Reach out to S. Phaneuf & Associates for fast estimates across Massachusetts."> #}
  <meta property="og:type" content="website"> 
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ site.url }}/images/{{ ogImage or site.defaultOgImage }}">
  
  {# <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin=""> #}
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  {# <link rel="preload" href="/css/templatestyles.css" as="style" media="all"> #}
  <!--link rel="preload" fetchpriority="high" as="image" href="/images/S-Phaneuf-Associates.webp" type="image/webp"-->
  
  {% if heroImageMobile %}<link rel="preload" fetchpriority="high" as="image" href="/images/{{ heroImageMobile }}" type="image/webp" media="(max-width: 1023px)">{% endif %}
  {% if heroImageDesktop %}<link rel="preload" fetchpriority="high" as="image" href="/images/{{ heroImageDesktop }}" type="image/webp" media="(min-width: 1024px)">{% endif %}
  
  <link rel="stylesheet" href="/css/templatestyles.css">{{ extraCss | safe }}
  
  <link rel="icon" href="/images/favicon96c.png" sizes="96x96">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="shortcut icon" type="image/png" href="/images/favicon32.png">
  <meta name="theme-color" content="#303f5e">
  <meta name="msapplication-TileColor" content="#303f5e">
  <meta name="msapplication-TileImage" content="/images/apple-touch-icon.png">
  <meta name="seobility" content="69ae98e4ec0c1d0ab86a1032c9767d87">
  {# <script src="https://www.googletagmanager.com/gtag/js?id=G-FXE2B9T9WF" async=""></script> #}

  <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@graph": [
    {%- include "schema/webpage.njk" -%},
    {%- include "schema/business.njk" -%}
    {%- if page.url != '/' -%},{% include "schema/breadcrumbs.njk" %}{%- endif -%}
    {%- include "schema/service.njk" -%}
    {%- if extraSchema -%},{{- extraSchema | safe -}}{%- endif -%}
    ]
  }</script>
</head>
<body class="{{ page.fileSlug }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {% include "components/global/global-header.njk" %}
  <main id="main-content">
    {% if heroHeading %}{% include "components/global/global-hero.njk" %}{% endif %}
    {{ content | safe }}
  </main>
  {% include "components/global/global-footer.njk" %}
  
<script>
  // Mobile Navigation
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('menu-toggle');const drawer = document.getElementById('main-nav');const backdrop = document.getElementById('nav-backdrop');const dropdownToggle = document.querySelector('.q-dropdown-toggle');const dropdownParent = document.querySelector('.q-has-dropdown');
    // Open/Close Mobile Drawer
    function openMenu() {toggleBtn.setAttribute('aria-expanded', 'true');drawer.classList.add('q-is-open');backdrop.classList.add('q-is-active');document.body.style.overflow = 'hidden';}
    function closeMenu() {toggleBtn.setAttribute('aria-expanded', 'false');drawer.classList.remove('q-is-open');backdrop.classList.remove('q-is-active');document.body.style.overflow = '';}
    toggleBtn.addEventListener('click', () => {const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';isOpen ? closeMenu() : openMenu();});
    backdrop.addEventListener('click', closeMenu);
    // Mobile Accordion Toggle for Services Submenu
    if (dropdownToggle) {dropdownToggle.addEventListener('click', (e) => {e.preventDefault();const isExpanded = dropdownToggle.getAttribute('aria-expanded') === 'true';dropdownToggle.setAttribute('aria-expanded', !isExpanded);dropdownParent.classList.toggle('q-dropdown-open');});}
    // Keyboard Navigation (Escape key)
    document.addEventListener('keydown', (e) => {if (e.key === 'Escape' && drawer.classList.contains('q-is-open')) {closeMenu();}  });
  });
  // Contact Form Submission to Google Forms
  document.getElementById('contact-form').onsubmit = function (e) {
    e.preventDefault();
    const form = this;
    const formData = new FormData(form);
    const errorDiv = document.getElementById('form-error');
    // Helper function to safely display error messages
    const showError = (msg) => { if (errorDiv) { errorDiv.textContent = msg; errorDiv.style.display = 'block'; } else { console.error("Error container #form-error missing:", msg); } };
    // Clear previous errors safely
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    // Honeypot check (bot prevention)
    if (formData.get("city") !== "") { form.innerHTML = `<div class="alert alert-success">Thank you!</div>`; return; }
    const messageText = formData.get("entry.69405291") || "";
    // Validation checks
    const tagRegex = /<[^>]*>/g;
    if (tagRegex.test(messageText)) { showError("HTML tags and scripts are not allowed."); return; }
    const urlRegex = /(https?:\/\/[^\s]+)|(www\.[^\s]+)/gi;
    if (urlRegex.test(messageText)) { showError("Links and URLs are not allowed."); return; }
    const englishRegex = /^[ -~]*$/;
    if (!englishRegex.test(messageText)) { showError("Please use English characters only."); return; }
    const submitButton = form.querySelector('button');
    if (submitButton) { submitButton.disabled = true; submitButton.textContent = "Sending...";  }
    const data = new URLSearchParams(formData);
    fetch("https://docs.google.com/forms/u/0/d/e/1FAIpQLScWBdxmWBtQ3kd-p9eZjKsJla-A0Py6BAFPqPTjhCsaNyO4Uw/formResponse", { method: "POST", mode: "no-cors", body: data }).then(() => { form.innerHTML = `<div class="alert alert-success"><strong>Success!</strong> Your message has been sent.</div>`; }).catch(error => { if (submitButton) { submitButton.disabled = false; submitButton.textContent = "Submit"; } showError("Something went wrong. Please try again."); }); 
  };
  // Google Tag Manager (GTM) Lazy Load
  function loadGTM(){if(window.gtmLoaded)return;window.gtmLoaded=!0;var script=document.createElement('script');script.src="https://www.googletagmanager.com/gtag/js?id=G-FXE2B9T9WF";script.async=!0;document.head.appendChild(script);script.onload=function(){window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-FXE2B9T9WF');};}
  ['pointerdown','keydown','touchstart','scroll'].forEach(function(e){window.addEventListener(e,loadGTM,{once:!0,passive:!0});});
  if('requestIdleCallback' in window){requestIdleCallback(function(){setTimeout(loadGTM,3500);});}else{setTimeout(loadGTM,4000);}
  {{ extraJs | safe }}
</script>   
{# <!--<script src="/js/main.js" defer></script>--> #}
</body>
</html>