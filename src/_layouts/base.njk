<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title | safe or site.name | safe }}</title>
  <meta name="description" content="{{ description | safe or site.defaultDescription | safe }}">
  {% set rawPath = canonical or page.url %}{% set cleanPath = rawPath | replace('index.html', '') | replace('.html', '') %}{% if cleanPath != '/' and cleanPath.endsWith('/') %}{% set cleanPath = cleanPath.slice(0, -1) %}{% endif %}{% set canonicalUrl = "https://sphaneufassociates.com" ~ cleanPath %}<link rel="canonical" href="{{ canonicalUrl }}">
  {% if robots %}
    <meta name="robots" content="{{ robots }}">
  {% else %}
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}
  
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="S. Phaneuf & Associates">
  <meta property="og:title" content="{{ title | safe or site.name | safe}}">
  <meta property="og:description" content="{{ description | safe or site.defaultDescription | safe }}">
  {# <meta property="og:description" content="Ready to start your residential or commercial project? Reach out to S. Phaneuf & Associates for fast estimates across Massachusetts."> #}
  <meta property="og:type" content="website"> 
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ site.url }}/images/{{ ogImage or site.defaultOgImage }}">
  
  {# <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin=""> #}
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  {# <link rel="preload" href="/css/templatestyles.css" as="style" media="all"> #}
  <!--link rel="preload" fetchpriority="high" as="image" href="/images/S-Phaneuf-Associates.webp" type="image/webp"-->
  
  {% if heroImageMobile %}<link rel="preload" fetchpriority="high" as="image" href="/images/{{ heroImageMobile }}" type="image/webp" media="(max-width: 1023px)">{% endif %}
  {% if heroImageDesktop %}<link rel="preload" fetchpriority="high" as="image" href="/images/{{ heroImageDesktop }}" type="image/webp" media="(min-width: 1024px)">{% endif %}
  
  <link rel="stylesheet" href="/css/templatestyles.css">{{ extraCss | safe }}
  
  <link rel="icon" href="/images/favicon96c.png" sizes="96x96">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="shortcut icon" type="image/png" href="/images/favicon32.png">
  <meta name="theme-color" content="#303f5e">
  <meta name="msapplication-TileColor" content="#303f5e">
  <meta name="msapplication-TileImage" content="/images/apple-touch-icon.png">
  <meta name="seobility" content="69ae98e4ec0c1d0ab86a1032c9767d87">
  {# <script src="https://www.googletagmanager.com/gtag/js?id=G-FXE2B9T9WF" async=""></script> #}

  <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@graph": [
    {% include "schema/webpage.njk" %},
    {% include "schema/business.njk" %}
    {%- if page.url != '/' %},{% include "schema/breadcrumbs.njk" %}{% endif %}
    {%- if extraSchema %},{{ extraSchema | safe }}{% endif %}
  ]
  }</script>

{#   
  <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@graph": [{% include "schema/business.njk" %}{% if page.url != '/' %},{% include "schema/breadcrumbs.njk" %}{% endif %}{% if extraSchema %},{{ extraSchema | safe }}{% endif %}]
  }</script>
 #}

</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  {% include "header.njk" %}
  <main id="main-content" class="{{ mainClass }}">
    {% if heroHeading %}{% include "components/hero.njk" %}{% endif %}
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  
<script>
    var textBoxes = document.querySelectorAll('.text-box');
    var observer = new IntersectionObserver(entries => {entries.forEach(entry => {if (entry.isIntersecting) {entry.target.classList.add('slide-up');observer.unobserve(entry.target);}});});textBoxes.forEach(textBox=>{ observer.observe(textBox);});
    function naviconClick(navicon) {
        navicon.classList.toggle("change");
        var nav = document.getElementById("navbar");
        if (nav) nav.classList.toggle("navbar-change");
    }
    function navDropdownClick(e) {
      // Only intercept click on touch devices / mobile screens (< 600px)
      if (window.innerWidth < 600) {
        var navDropdown = document.getElementById("nav-dropdown");
        // If the dropdown isn't open yet on mobile, open it first
        if (navDropdown && !navDropdown.classList.contains("show")) {
          e.preventDefault(); 
          navDropdown.classList.add("show");
        }
        // If it IS already open on mobile, tapping it again will naturally follow the link to /services/
      }
    }
    // Close dropdown when clicking outside
    window.addEventListener('click', function(e) {
      if (!e.target.closest('.dropdown')) {
        var navDropdown = document.getElementById("nav-dropdown");
        if (navDropdown && navDropdown.classList.contains("show")) {
          navDropdown.classList.remove("show");
        }
      }
    });
    window.addEventListener('load', function(){ var script=document.createElement('script'); script.src="https://www.googletagmanager.com/gtag/js?id=G-FXE2B9T9WF"; script.async=true; document.head.appendChild(script); script.onload=function(){ window.dataLayer=window.dataLayer || []; function gtag(){dataLayer.push(arguments)} gtag('js', new Date()); gtag('config', 'G-FXE2B9T9WF');};});
    {# document.addEventListener('DOMContentLoaded', () => {
        let currentIndex=0; 
        const gallery=document.getElementById('gallery'); 
        if (!gallery) return; 
        const spans=gallery.querySelectorAll('p.lb');
        for (let i = 0; i < spans.length; i++) {
          spans[i].addEventListener('click', () => {
            currentIndex = i;
            openLightbox(spans[currentIndex].getAttribute('data-src'));
          });
        }
        function openLightbox(imageSrc) {document.body.classList.add('noScroll'); const lightbox=document.createElement('div'); lightbox.id='lightbox'; const img=document.createElement('img'); img.src=imageSrc;img.id='lb-img';img.style.position="absolute";const prevButton = document.createElement('button');prevButton.className = 'nav-button prev';prevButton.innerHTML = '❮';prevButton.addEventListener('click', (event) => {event.stopPropagation();showPrevImage();});const nextButton = document.createElement('button');nextButton.className = 'nav-button next';nextButton.innerHTML = '❯';nextButton.addEventListener('click', (event) => {event.stopPropagation();showNextImage();});const closeButton = document.createElement('button');closeButton.className = 'nav-button close';closeButton.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='#fff' style='height: 17px;'><path d='M.293.293a1 1 0 011.414 0L8 6.586 14.293.293a1 1 0 111.414 1.414L9.414 8l6.293 6.293a1 1 0 01-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 01-1.414-1.414L6.586 8 .293 1.707a1 1 0 010-1.414z'/></svg>`;closeButton.addEventListener('click', (event) => {event.stopPropagation();closeLightbox();});const counter = document.createElement('div');counter.className = 'counter';counter.innerText = `${currentIndex + 1}/${spans.length}`;lightbox.appendChild(img);lightbox.appendChild(prevButton);lightbox.appendChild(nextButton);lightbox.appendChild(closeButton);lightbox.appendChild(counter);document.body.appendChild(lightbox);const initialLeft = window.innerWidth / 2 - img.offsetWidth / 2;img.style.left = initialLeft + 'px';}
        function showPrevImage() {currentIndex = (currentIndex > 0) ? currentIndex - 1 : spans.length - 1;updateLightboxImage(spans[currentIndex].getAttribute('data-src'));}
        function showNextImage() {currentIndex = (currentIndex < spans.length - 1) ? currentIndex + 1 : 0;updateLightboxImage(spans[currentIndex].getAttribute('data-src'));}
        function updateLightboxImage(imageSrc) {const lightbox = document.getElementById('lightbox');const img = lightbox.querySelector('img');img.src = imageSrc;const counter = lightbox.querySelector('.counter');counter.innerText = `${currentIndex + 1}/${spans.length}`;}
        function closeLightbox() {const lightbox = document.getElementById('lightbox');if (lightbox) {document.body.classList.remove('noScroll');document.body.removeChild(lightbox);}}
    }); #}
    {{ extraJs | safe }}
</script>   
{# <!--<script src="/js/main.js" defer></script>--> #}
</body>
</html>