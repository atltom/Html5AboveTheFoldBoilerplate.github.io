{% include "components/breadcrumbs.njk" %}
<div class="container flex-container mb-5 pb-5">
    <article class="mt-5 content" id="service-areas">
        <section class="intro-section" id="massachusetts-construction-services">
            <h2 class="pipe">
                Construction Services Throughout Massachusetts
            </h2>
            <p>
                S. Phaneuf & Associates provides professional masonry, hardscape construction, asphalt paving, excavation, site
                development, and snow management services throughout Massachusetts.
            </p>
            <p>
                We proudly serve homeowners and businesses throughout Greater Boston and surrounding communities with dependable
                workmanship and quality construction solutions.
            </p>
        </section>
        <section class="py-5" id="massachusetts-counties-served">
            <h2 class="pipe">
                Massachusetts Counties We Serve
            </h2>
            <p>
            S. Phaneuf & Associates proudly provides masonry, hardscape construction,
            asphalt paving, excavation, site development, and snow management services
            throughout Massachusetts. We work with homeowners, businesses, and commercial
            property owners across multiple counties throughout Central and Eastern
            Massachusetts.
            </p>
            {% for county in counties %}
                <h3>{{ county.name }}</h3>
                <p>{{ county.description }}</p>
            {% endfor %}
        </section>
        <section class="py-5" id="communities-served">
            <h2 class="pipe">
                Communities We Serve Throughout Massachusetts
            </h2>
            <p>
            S. Phaneuf & Associates proudly provides masonry, hardscape construction,
            asphalt paving, excavation, site development, and snow management services
            to homeowners and businesses throughout Greater Boston and surrounding
            Massachusetts communities. We regularly complete projects in the towns listed
            below, providing dependable construction solutions designed for residential
            and commercial properties.
            </p>
            <p class="pt-2 pb-3">Some of the communities we regularly serve include:</p>
            <div class="areas-grid">
                {% for area in communities %}
                    <div class="area-item">
                        {% if area.link %}
                            <a href="{{ area.link }}">{{ area.name }}</a>
                        {% else %}
                            {{ area.name }}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>
        <section class="py-5" id="massachusetts-service-area-map">
            <h2 class="pipe">
                Our Massachusetts Service Area
            </h2>
            <p>
            S. Phaneuf & Associates serves homeowners and businesses throughout Central
            and Eastern Massachusetts. Our service area includes communities across
            Middlesex, Worcester, Norfolk, Essex, Suffolk, Plymouth, and Bristol Counties.
            </p>
            <div class="map-responsive">
                <iframe
                    title="Google Map showing service areas in Massachusetts"
                    src="https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d898468.0466178987!2d-71.26502105913673!3d42.29465079589885!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1smassachusetts%20county%20map!5e0!3m2!1sen!2sus!4v1726834663704!5m2!1sen!2sus"
                    height="350"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </section>
        <section class="py-5" id="construction-services-massachusetts">
            <h2 class="pipe">Construction Services Available Throughout Massachusetts</h2>
            {% for service in servicess %}
                <h3>
                    <a href="{{ service.link }}">
                        {{ service.name }}
                    </a>
                </h3>
                <p>
                    {{ service.description }}
                </p>
            {% endfor %}
        </section>
        {% include "components/why-phaneuf.njk" %}
        <section class="py-5" id="service-area-faq">
            <h2 class="pipe">
                Frequently Asked Questions About Our Service Areas
            </h2>
            {% for item in faq %}
                <h3>{{ item.question }}</h3>
