 {% set baseURL = "https://sphaneufassociates.com" %}{% set currentPath = canonical or page.url %}{# Strip .html extension and/or trailing slashes #}{% set cleanPath = currentPath | replace(r/(\.html|\/)$/, "") %}{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ baseURL }}/"
    }{% if breadcrumbs %}{% for crumb in breadcrumbs %},{
      "@type": "ListItem",
      "position": {{ loop.index + 1 }},
      "name": "{{ crumb.title | safe }}",
      "item": "{{ baseURL }}{{ crumb.url | replace(r/(\.html|\/)$/, "") }}"
    }{% endfor %}{% endif %},{
      "@type": "ListItem",
      "position": {{ (breadcrumbs | length) + 2 if breadcrumbs else 2 }},
      "name": "{{ (breadcrumbTitle or serviceName or title) | safe }}",
      "item": "{{ baseURL }}{{ cleanPath }}"
    }
  ]
}