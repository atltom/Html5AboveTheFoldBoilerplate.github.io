<!-- why choose phaneuf-->
{% if whyChoose %}<section id="why-choose-phaneuf" >
    {% if whyChoose.heading %}<h2>{{ whyChoose.heading }}</h2>{% endif %}
    <div class="row ">
        {% for item in whyChoose.items %}<div class="col-md-6 ">
            {% if item.title %}<h3>{{ item.title }}</h3>{% endif %}
            {% if item.description %}<p>{{ item.description }}</p>
        {% endif %}</div>{% endfor %}
    </div>
</section>{% endif %}