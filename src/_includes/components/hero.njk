<!--hero-->
<div id="hero" class="big-image {{ heroImageClass }}">
    <div class="overlay">
        <h1 class="hero-h1">{{ heroHeading | safe }}{% if heroHeadingNoWrap %}<span class="no-wrap">{{ heroHeadingNoWrap }}</span>{% endif %}</h1>
        <hr class="my-3 mx-1">
        <p class="hero-p p-0 fw-7">{{ heroSubheading |safe }}</p>
        {% if heroTrust %}<p class="hero-trust">{% for item in heroTrust %}{% if not loop.first %}<span class="separator">•</span>{% endif %}<span>✓ {{ item }}</span>{% endfor %}</p>{% endif %}
        {% if heroCTA %}<div class="t-c mt-3"><a class="hero-btn btn fw-6" href="{{ heroCTALink | default('/contact-us#contact-form') }}">{{ heroCTA }}</a></div>{% endif %}
    </div>
</div>