<!--sidebar-->
<div id="sidebar-contact-form">
    <h2>{{ sidebarHeading }}</h2>
    {% for p in sidebarParagraph %}
    <p class="mt-2 mb-4">{{ p }}</p>
    {% endfor %}
    {% if sidebarTrust %}
    <div class="mb-4">
        <p>
        ✔ Free estimates
        <br>
        ✔ Serving Massachusetts since 1989
        <br>
        ✔ Residential & Commercial
        <br>
        ✔ Licensed & Insured
        </p>
    </div>
    {% endif %}
    <form id="contact-form" class="pb-3">
        <div class="mb-3">
            <label for="first-last-name" class="form-label">First and Last Name</label>
            <input id="first-last-name" type="text" class="form-control" name="name" required>
        </div>
        <div class="mb-3">
            <label for="email-or-phone" class="form-label">Email Address or Phone #</label>
            <input id="email-or-phone" type="text" class="form-control" name="contact" required>
        </div>
        <div class="mb-3">
            <label for="message" class="form-label">Tell us about your project</label>
            <textarea id="message" class="form-control" rows="5" name="message" required></textarea>
        </div>
        <button type="submit" class="btn">Request Your Free Estimate</button>
    </form>



    {% if showToc %}
    <nav class="table-of-contents my-4 p-3 bg-light border rounded">
        <p class="h5 fw-bold mb-2">On This Page:</p>
        <ul class="list-unstyled mb-0">
        {% for item in excavation.services.items %}
            <li class="mb-1">
            <a href="#{{ item.title | slugify }}" class="text-decoration-none">
                {{ item.title }}
            </a>
            </li>
        {% endfor %}
        <li>
            <a href="#frequently-asked-questions" class="text-decoration-none">
            Frequently Asked Questions
            </a>
        </li>
        </ul>
    </nav>
    {% endif %}

    {# {% if sidebarImages and sidebarImages.length %}
    <ul id="sidebar-images" class="p-0 lst-n">
        {% for image in sidebarImages %}
        <li>
            <figure class="mx-0">
                <img loading="lazy" src="{{ image.src }}" alt="{{ image.alt }}" width="226" height="348">
                <figcaption class="p-3 bg-w border"><address>{{ image.location }}</address>{{ image.caption }}</figcaption>
            </figure>
        </li>
        {% endfor %}
    </ul>
    {% endif %} #}
 {% if sidebarShowImages == "false" %}
    
  {% else %}
    {% set imgData = sidebarImages.sidebarImages if sidebarImages.sidebarImages else sidebarImages %}    
    {% set activeKey = sidebarKey or page.fileSlug %}    
    {% if imgData and imgData[activeKey] and (imgData[activeKey] | length > 0) %}    
        {% set activeImages = imgData[activeKey] %}    
    {% elif imgData and imgData.default and (imgData.default | length > 0) %}    
        {% set activeImages = imgData.default %}   
    {% else %}    
        {% set activeImages = [] %}   
    {% endif %}
    
    {% if activeImages and (activeImages | length > 0) %}
        <ul id="sidebar-images" class="p-0 lst-n">
            {% for img in activeImages %}
            <li>
                <figure class="mx-0">
                    <img loading="lazy" src="{{ img.src }}" alt="{{ img.alt }}" decoding="async" width="226" height="348">
                    {% if img.location or img.caption %}
                        <figcaption class="p-3 bg-w border">
                            {% if img.location %}<span class="location-badge">{{ img.location }}</span>{% endif %}
                            {% if img.caption %}<p>{{ img.caption }}</p>{% endif %}
                        </figcaption>
                    {% endif %}
                </figure>
            </li>
            {% endfor %}
        </ul>
    {% else %}
        <!-- Debug: Could not resolve array for activeKey: "{{ activeKey }}" -->
    {% endif %}
 {% endif %}


</div>