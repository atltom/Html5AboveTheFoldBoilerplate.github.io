<!--areas-served-->
{% if areasServed %}<section id="{{ areasServed.heading | slugify }}">
  <h2>{{ areasServed.heading }}</h2>
  {% if areasServed.intro %}<p >{{ areasServed.intro | safe }}</p>{% endif %}
  <div class="areas-grid ">
    {% for location in areasServed.locations %}<div class="area-item">
        <p >{% if location.url %}<a href="{{ location.url }}">{{ location.name }}</a>{% else %}{{ location.name }}{% endif %}</p>
    </div>{% endfor %}
  </div>
</section>{% endif %} 