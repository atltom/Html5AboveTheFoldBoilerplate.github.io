<!--benefits-->
<section id="{{ service.benefits.heading | slugify }}">
    <h2>{{ service.benefits.heading }}</h2>
    <p >{{ service.benefits.intro }}</p>
    <div>
        {% for item in service.benefits.items %}
            <div>
                <h3>{{ item.title }}</h3>
                <p>{{ item.description }}</p>
            </div>
        {% endfor %}
    </div>
</section>