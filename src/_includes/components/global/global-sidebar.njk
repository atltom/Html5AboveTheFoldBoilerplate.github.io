<!-- form  -->
<div id="sidebar-contact-form">
    {% if sidebarLocation %}
        <h2>Get Your Free {{ sidebarLocation }} Project Estimate</h2>
        <p class=" ">Planning a paving, site development, or excavation project in {{sidebarLocation}}? Fill out the quick form below, and our local team will reach out promptly to discuss your project requirements and schedule a site evaluation.</p>
        <div ><p>- Free Local Estimates & Site Evaluations<br>- Serving {{sidebarLocation}} & Surrounding Communities<br>- Residential & Commercial Solutions<br>- Fully Licensed & Insured Contractor</p></div>
    {% else %}
        <h2>{{ sidebarHeading }}</h2>
        {% for p in sidebarParagraph %}<p class=" ">{{ p }}</p>{% endfor %}
        {% if sidebarTrust %}<div ><p>- Free estimates<br>- Serving Massachusetts since 1989<br>- Residential & Commercial<br>- Licensed & Insured</p></div>{% endif %}
    {% endif %}
    <form  id="contact-form" >
        <div >
            <label class="form-label" for="first-last-name">First and Last Name</label>
            <input class="form-control" id="first-last-name" name="name" type="text" required>
        </div>
        <div >
            <label class="form-label" for="email-or-phone">Email Address or Phone #</label>
            <input class="form-control" id="email-or-phone" name="contact" type="text" required>
        </div>
        <div >
            <label class="form-label" for="message">Tell us about your project</label>
            <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
        </div>
        <button class="btn" type="submit">Request Your Free Estimate</button>
    </form>
    {% if sidebarShowImages == "false" %}
        <!-- no images -->
    {% else %}
        <!-- images -->
        {% set imgData = sidbarImages.sidebarImages if sidebarImages.sidebarImages else sidebarImages %}{% set activeKey = sidebarKey or page.fileSlug %}{% if imgData and imgData[activeKey] and (imgData[activeKey] | length > 0) %}{% set activeImages = imgData[activeKey] %}{% elif imgData and imgData.default and (imgData.default | length > 0) %}{% set activeImages = imgData.default %}{% else %}{% set activeImages = [] %}{% endif %}
        {% if activeImages and (activeImages | length > 0) %}
            <ul class="sidebar-images" id="sidebar-images">
                {% for img in activeImages %}
                <li>
                    <figure>
                        <img src="{{ img.src }}" alt="{{ img.alt }}" width="226" height="348" loading="lazy" decoding="async">
                        {% if img.location or img.caption %}
                            <figcaption class="s sbg-w sborder">
                                {% if img.location %}<span class="location-badge">{{ img.location }}</span>{% endif %}
                                {% if img.caption %}<p>{{ img.caption }}</p>{% endif %}
                            </figcaption>
                        {% endif %}
                    </figure>
                </li>
                {% endfor %}
            </ul>
        {% else %}
            <!-- Debug: Could not resolve array for activeKey: "{{ activeKey }}" -->
        {% endif %}
    {% endif %}
    {% if showToc %}<!-- table-or-contents--><nav class="table-of-contents bg-light border"><p>On This Page:</p><ul class="list-unstyled ">{% for item in excavation.services.items %}<li ><a class="text-decoration-none" href="#{{ item.title | slugify }}" >{{ item.title }}</a></li>{% endfor %}<li><a class="text-decoration-none" href="#frequently-asked-questions">Frequently Asked Questions</a></li></ul></nav>{% endif %}
</div>