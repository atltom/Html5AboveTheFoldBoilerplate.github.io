<!-- final-cta -->
<hr style="margin:0;">
<section class="final-cta" id="{{ ctaSlug | slugify or 'final-cta' }}" aria-labelledby="cta-heading">
  <div class="container">
    <h2 id="final-cta-heading">{{ ctaHeading }}</h2>
    <p>{{ ctaText | safe }}</p>
    
    {% if ctaTrust %}
    <div class="final-cta-trust">
      {% for badge in ctaTrust %}
        <span class="final-trust-item"><span class="check" aria-hidden="true">✓</span> {{ badge }}</span>
      {% endfor %}
    </div>
    {% endif %}     
    
    <a href="tel:+19786694919" class="btn">CALL NOW&nbsp;&nbsp;978-669-4919</a>
  </div>
</section>

