<div class="container my-5 py-4">
    <article class="mt-5">
        <section class="pb-2 mb-2" style="border-bottom: 1px solid #ccc;">
            <h1>Sitemap for S. Phaneuf Associates Website</h1>
            {# <p class="fs-xs">Last Updated: October 30, 2025</p> #}
        </section>
        <section>
            <h2 class="fs-lg">Website Structure</h2>
            <ul>
                {%- for item in collections.all | sort(attribute="data.order") %}
                    {%- if item.url 
                        and not item.data.eleventyExcludeFromCollections 
                        and not item.url.endsWith('.css') 
                        and not item.url.endsWith('.js') %}
                        <li>
                            {% set rawUrl = item.url | replace(".html", "") %}
                            {% set cleanUrl = rawUrl if rawUrl == "/" else (rawUrl | replace(r/\/$/, "")) %} 
                            <a href="{{ cleanUrl }}">{{ item.data.sitemapTitle or item.data.navTitle or item.data.title or item.url }}</a>
                        </li>
                    {%- endif %}
                {%- endfor %}
            </ul>
        </section>
    </article>
</div> 



